PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/retain.db
# In production, set NODE_ENV=production and APP_ORIGIN to your HTTPS app URL.
# Set TRUST_PROXY=1 only when exactly one trusted reverse proxy sits in front of Node.
TRUST_PROXY=0
# Optional durable hosted SQLite (server-side secrets; never use VITE_ for these):
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token
# For a paid persistent volume instead of Turso, set PERSISTENT_DATABASE=1.
